{
  "name": "@rivinia/theme",
  "version": "1.0.2",
  "description": "The shared Rivinia design-token layer: one import, one place to set the whole component ecosystem's colours, shapes and type.",
  "keywords": [
    "angular",
    "design-tokens",
    "theming",
    "css",
    "tailwind",
    "bootstrap"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdelfattahqandil21-oss/Rivinia.git",
    "directory": "projects/theme"
  },
  "homepage": "https://github.com/abdelfattahqandil21-oss/Rivinia/tree/theme/v1.0.2/projects/theme#readme",
  "bugs": {
    "url": "https://github.com/abdelfattahqandil21-oss/Rivinia/issues"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "style": "./styles/theme.css",
      "default": "./styles/theme.css"
    },
    "./theme.css": "./styles/theme.css",
    "./tailwind.css": "./styles/tailwind.css",
    "./bootstrap.css": "./styles/bootstrap.css",
    "./scss": "./styles/_index.scss"
  }
}
