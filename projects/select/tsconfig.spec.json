/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["vitest/globals"]
  },
  /*
   * `ui/` is a SECONDARY ENTRY POINT, so its specs sit under `ui/src/`, not
   * `src/`. The previous `src/**` glob covered the headless controller only and
   * silently excluded every `rv-select` component spec — the regression and
   * positioning suites reported here were never executed by `ng test select`.
   */
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts", "ui/src/**/*.d.ts", "ui/src/**/*.spec.ts"]
}
