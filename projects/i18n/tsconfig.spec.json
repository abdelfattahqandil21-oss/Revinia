/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    /*
     * `node` is required by the CLI specs, which spawn the published
     * `rivinia-i18n-keys` binary in a child process (the same reason the
     * schematic specs carry it). Everything else in this suite is a
     * browser-environment spec and never touches a Node API.
     */
    "types": ["vitest/globals", "node"]
  },
  /*
   * The specs live in `<project>/tests`, OUTSIDE the source root: `src/`
   * holds only what the package ships. The test target's `include` (see
   * angular.json) reaches them; this tsconfig compiles them.
   */
  "include": ["src/**/*.d.ts", "tests/**/*.d.ts", "tests/**/*.spec.ts"]
}
