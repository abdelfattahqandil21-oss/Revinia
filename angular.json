{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "proof-core": {
      "projectType": "library",
      "root": "projects/proof-core",
      "sourceRoot": "projects/proof-core/src",
      "prefix": "rv",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/proof-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/proof-core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/proof-core/tsconfig.spec.json"
          }
        }
      }
    },
    "proof-second": {
      "projectType": "library",
      "root": "projects/proof-second",
      "sourceRoot": "projects/proof-second/src",
      "prefix": "rv",
      "architect": {
