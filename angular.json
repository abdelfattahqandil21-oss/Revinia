    "proof-core": {
      "projectType": "library",
      "root": "projects/proof-core",
      "sourceRoot": "projects/proof-core/src",
      "prefix": "rv",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/proof-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/proof-core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/proof-core/tsconfig.spec.json"
          }
        }
      }
    },
