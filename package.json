{
  "name": "rivinia",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "schematics:http": "tsc -p projects/http/schematics/tsconfig.schematics.json && mv projects/http/schematics/ng-add/index.js projects/http/schematics/ng-add/index.cjs",
    "schematics:toast": "tsc -p projects/toast/schematics/tsconfig.schematics.json && mv projects/toast/schematics/ng-add/index.js projects/toast/schematics/ng-add/index.cjs",
    "schematics:i18n": "tsc -p projects/i18n/schematics/tsconfig.schematics.json && mv projects/i18n/schematics/ng-add/index.js projects/i18n/schematics/ng-add/index.cjs",
    "schematics:modal": "tsc -p projects/modal/schematics/tsconfig.schematics.json && mv projects/modal/schematics/ng-add/index.js projects/modal/schematics/ng-add/index.cjs",
    "schematics:env": "tsc -p projects/env/schematics/tsconfig.schematics.json && mv projects/env/schematics/ng-add/index.js projects/env/schematics/ng-add/index.cjs",
    "build:http": "pnpm schematics:http && ng build http",
    "build:toast": "pnpm schematics:toast && ng build toast",
    "build:i18n": "pnpm schematics:i18n && ng build i18n",
    "build:modal": "pnpm schematics:modal && ng build modal",
    "build:env": "pnpm schematics:env && ng build env",
    "build:menu": "ng build menu",
    "build:select": "ng build select",
    "test:schematics": "vitest run projects/http/schematics projects/toast/schematics projects/i18n/schematics projects/modal/schematics projects/env/schematics",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.2",
    "@angular-devkit/schematics": "^22.2.2",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
