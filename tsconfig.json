/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "paths": {
      "@rivinia/proof-core": ["./dist/proof-core"],
      "@rivinia/proof-core/ui": ["./dist/proof-core/ui"],
      "@rivinia/proof-second": ["./dist/proof-second"],
      "@rivinia/http": ["./dist/http"],
      "@rivinia/toast": ["./dist/toast"],
      "@rivinia/toast/ui": ["./dist/toast/ui"]
    },
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/proof-core/tsconfig.lib.json"
    },
    {
      "path": "./projects/proof-core/tsconfig.spec.json"
    },
    {
      "path": "./projects/proof-second/tsconfig.lib.json"
    },
    {
      "path": "./projects/proof-second/tsconfig.spec.json"
    },
    {
      "path": "./projects/http/tsconfig.lib.json"
    },
    {
      "path": "./projects/http/tsconfig.spec.json"
    },
    {
      "path": "./projects/toast/tsconfig.lib.json"
    },
    {
      "path": "./projects/toast/tsconfig.spec.json"
    }
  ]
}
